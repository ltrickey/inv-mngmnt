# Example Terraform Variables Configuration
# Copy this file to terraform.tfvars and customize for your environment
# cp terraform.tfvars.example terraform.tfvars

# AWS Region
aws_region = "us-east-1"

# Environment name (e.g., dev, test, prod)
environment = "test"

# Project name used for resource naming
project_name = "product-catalogue"

# IAM Configuration
# IAM Role: used as the execution/task role for all ECS Fargate services
# For AWS Academy/Learner Lab, use "LabRole" (default)
# For custom AWS accounts, specify your role name (must allow ECR pull,
# CloudWatch Logs, and DynamoDB access)
iam_role_name = "LabRole"

# Network Access
# Restrict this in production to specific IP ranges
# Example: ["1.2.3.4/32", "5.6.7.8/32"]
allowed_cidr_blocks = ["0.0.0.0/0"]

# Note: S3 bucket for images is always created when deploying to AWS
# For local development, the Flask app automatically serves images from infrastructure/images/
